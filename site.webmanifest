{
  "name": "Tidelyne",
  "short_name": "Tidelyne",
  "id": "/JAC_Online/",
  "lang": "en",
  "dir": "ltr",
  "description": "Free swim training app that works offline: 3D stroke visualizer, technique library, AI coach, pace calculators, deck timers, race planner and training log.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "categories": ["sports", "health", "education"],
  "background_color": "#040d18",
  "theme_color": "#040d18",
  "icons": [
    {
      "src": "favicon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "apple-touch-180.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "logo-mark.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" },
  "screenshots": [
    {
      "src": "screenshot-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Tidelyne on a desktop: the race split generator with a 200 m split table"
    },
    {
      "src": "screenshot-phone.jpg",
      "sizes": "750x1334",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Tidelyne on a phone: the pool-deck tempo trainer, interval timer and pace clock"
    }
  ],
  "shortcuts": [
    {
      "name": "Training Log",
      "short_name": "Log",
      "description": "Log a session",
      "url": "./#log",
      "icons": [{ "src": "favicon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Pace Calculator",
      "short_name": "Calculator",
      "description": "Golf Score, splits, pace zones",
      "url": "./#calculator",
      "icons": [{ "src": "favicon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "AI Coach",
      "short_name": "Coach",
      "description": "Ask the AI swim coach",
      "url": "./#ai",
      "icons": [{ "src": "favicon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
